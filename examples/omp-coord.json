{
  "scope": "my-project",
  "agents": {
    "pools": {
      "work": { "cap": 6, "loadCaps": [{ "above": 12, "cap": 3 }] },
      "short": { "cap": 2, "agentTypes": ["scout"] }
    },
    "exempt": ["reviewer", "security-reviewer"],
    "nested": { "allow": ["reviewer"], "maxRunningPerParent": 1 },
    "holdMinutes": 5
  },
  "queues": {
    "build": {
      "slots": 2,
      "order": "fair-share",
      "lanes": ["urgent", "normal"],
      "agingMinutes": 15,
      "timeoutMinutes": 60,
      "onDuplicate": "supersede",
      "loadSlots": [{ "above": 12, "slots": 1 }]
    },
    "test": { "slots": 3, "order": "fair-share", "agingMinutes": 10, "timeoutMinutes": 30 }
  },
  "commands": [
    {
      "pattern": "(?:(?<![\\w.-])(?:rm|rmdir|unlink|trash|shred)(?![\\w.-])|\\s-delete\\b|(?=((?<![\\w.-])git\\b[^;&|\\n]{0,200}?\\sclean\\b))\\1)[^;&\\n]{0,2000}(?:\\\\\\n[^;&\\n]{0,2000}){0,4}(?:^|[\\s=(])(?!['\"]?(?:(?:/private)?/(?:tmp|var/folders)/|\\$\\{?TMPDIR(?::-[^}\\s]*)?\\}?['\"]?/)(?![^\\s;&|=(]*\\.\\./))['\"]?[^\\s;&|=(]*rr-cache|(?:^|[\\s=(])(?!['\"]?(?:(?:/private)?/(?:tmp|var/folders)/|\\$\\{?TMPDIR(?::-[^}\\s]*)?\\}?['\"]?/)(?![^\\s;&|=(]*\\.\\./))['\"]?[^\\s;&|=(]*rr-cache[^;&\\n]{0,2000}(?:\\\\\\n[^;&\\n]{0,2000}){0,4}(?:(?<![\\w.-])(?:rm|rmdir|unlink|trash|shred)(?![\\w.-])|\\s-delete\\b|(?<![\\w.-])git\\b[^;&|\\n]{0,200}\\sclean\\b)|(?<![\\w.-])git\\b[^;&|\\n]{0,200}\\s--work-tree[=\\s][^;&|\\n]{0,200}rr-cache[^;&|\\n]{0,200}\\sclean\\b|(?:^|[;&|\\n({\\`]|(?<=\\s)['\"])[^\\S\\n]*(?:cd|pushd)[^\\S\\n]+(?:-[-\\w]*[^\\S\\n]+)?(?!['\"]?(?:(?:/private)?/(?:tmp|var/folders)/|\\$\\{?TMPDIR(?::-[^}\\s]*)?\\}?['\"]?/)(?![^\\s;&|=(]*\\.\\./))(?=[^;&|\\n]{0,2000}(?:\\\\\\n[^;&|\\n]{0,2000}){0,4}rr-cache)(?:\"[^\"\\n]*\"|'[^'\\n]*'|\\$\\([^)\\n]*\\)|[^\\s;&|\"'$<>]|\\$(?!\\())+(?:(?:[^\\S\\n]+\\d+|[^\\S\\n]*)&?[<>]&?[^\\s;&|<>]*){0,4}(?:[^\\S\\n]*\\|\\|[^\\S\\n]*(?:exit|return)(?:[^\\S\\n]+\\d+)?)?[^\\S\\n]*(?:\\\\\\n[^\\S\\n]*)?(?:&&|;|\\n)[\\s\\\\]*(?:(?:sudo|command)\\s+)*(?:/\\S*/)?(?:(?:(?<![\\w.-])(?:rm|rmdir|unlink|trash|shred)(?![\\w.-])|\\s-delete\\b|(?<![\\w.-])git\\b[^;&|\\n]{0,200}\\sclean\\b)|find\\b[^;&|\\n]{0,2000}(?:\\\\\\n[^;&|\\n]{0,2000}){0,4}\\s-delete\\b)",
      "action": "refuse",
      "reason": "git's rerere cache is shared by every worktree and session, and deleting it loses other sessions' recorded resolutions: to keep a throwaway build's resolutions out, run that command with `git -c rerere.enabled=false …`"
    },
    {
      "pattern": "(?:^|[;&|\\n({\\`]|(?<=\\s)['\"])(?![^;&|\\n]{0,500}?(?:GIT_DIR=|--git-dir[=\\s]|\\s-C\\s+)['\"]?(?:(?:/private)?/(?:tmp|var/folders)/|\\$\\{?TMPDIR(?::-[^}\\s]*)?\\}?['\"]?/)(?![^\\s;&|=(]*\\.\\./)(?=[^;&|\\n]{0,500}?\\srerere\\b))[^\\S\\n]*(?:(?:\\w+=(?:\"[^\"\\n]*\"|'[^'\\n]*'|\\$\\([^)\\n]*\\)|\\`[^\\`\\n]*\\`|[^\\s\"'$\\`]|\\$(?!\\()){0,512}|sudo(?:\\s+-\\w+)*|command|exec|nice(?:\\s+-\\w+(?:\\s+\\d+)?)?|!|if|while|until|elif|env(?:\\s+-\\w+)*|time(?:\\s+-\\w+)*|nohup|do|then|else|xargs(?:\\s+-\\w+)*|timeout(?:\\s+(?:-[sk]\\s+\\S+|--?[\\w-]+)){0,4}\\s+\\S+)\\s+){0,8}(?:(?:/[\\w.-]+)+/)?git\\b(?:(?:\\s+(?:\\\\\\n\\s*)*|(?:\\\\\\n\\s*)+)(?:-c(?:\\s+(?:\\\\\\n\\s*)*|(?:\\\\\\n\\s*)+)(?!-)(?:[^\\s\"'$\\`\\\\]|\\\\[^\\n]|\\$(?!\\()|\\$\\([^)\\n]*\\)|\\`[^\\`\\n]*\\`|\"[^\"]*\"|'[^']*'){1,4096}|-C(?:\\s+(?:\\\\\\n\\s*)*|(?:\\\\\\n\\s*)+)(?!-)(?:[^\\s\"'$\\`\\\\]|\\\\[^\\n]|\\$(?!\\()|\\$\\([^)\\n]*\\)|\\`[^\\`\\n]*\\`|\"[^\"]*\"|'[^']*'){1,4096}|--(?:git-dir|work-tree|namespace|exec-path)(?:\\s+(?:\\\\\\n\\s*)*|(?:\\\\\\n\\s*)+)(?!-)(?:[^\\s\"'$\\`\\\\]|\\\\[^\\n]|\\$(?!\\()|\\$\\([^)\\n]*\\)|\\`[^\\`\\n]*\\`|\"[^\"]*\"|'[^']*'){1,4096}|--[\\w-]+(?:=(?:[^\\s\"'$\\`\\\\]|\\\\[^\\n]|\\$(?!\\()|\\$\\([^)\\n]*\\)|\\`[^\\`\\n]*\\`|\"[^\"]*\"|'[^']*'){0,4096})?|-\\w+)){0,64}(?:\\s+(?:\\\\\\n\\s*)*|(?:\\\\\\n\\s*)+)rerere(?:(?:\\s+(?:\\\\\\n\\s*)*|(?:\\\\\\n\\s*)+)--?[\\w-]+){0,8}(?:\\s+(?:\\\\\\n\\s*)*|(?:\\\\\\n\\s*)+)(?:clear|forget|gc)\\b",
      "action": "refuse",
      "reason": "git's rerere cache is shared by every worktree and session, and deleting it loses other sessions' recorded resolutions: to keep a throwaway build's resolutions out, run that command with `git -c rerere.enabled=false …`"
    },
    {
      "pattern": "(?<![\\w.-])g?sed(?:\\s+-\\S+){0,8}?\\s+(?:-[A-Za-z]*i\\S*|--in-place\\S*)(?=\\s|$)",
      "action": "refuse",
      "agents": "sub",
      "reason": "sed -i rewrites files in place without showing what changed: use the edit tool (read the lines first). For one rewrite across many files, save a script with the write tool and run it from a short command. If the text only mentions it (a commit message, a PR body), put it in a file with the write tool and pass the file"
    },
    {
      "pattern": "(?<![\\w.-])perl(?:\\s+-\\S+){0,8}?\\s+-(?![IMmdDwWxX])\\w*i\\S*(?=\\s|$)",
      "action": "refuse",
      "agents": "sub",
      "reason": "perl -i rewrites files in place without showing what changed: use the edit tool (read the lines first). For one rewrite across many files, save a script with the write tool and run it from a short command. If the text only mentions it (a commit message, a PR body), put it in a file with the write tool and pass the file"
    },
    {
      "pattern": "(?<![\\w.-])python[0-9.]*(?=((?:\\s+-(?![c-]\\b)(?![\\s<])\\S*(?:\\s+(?![-<])[A-Za-z][\\w.]*)?){0,8}))\\1\\s+(?:-c\\b|-(?=\\s*<<)|<<|-\\s)(?=[\\s\\S]*?(?:\\.write_(?:text|bytes)\\(|\\bopen\\((?:[^,()\\n]|\\([^()\\n]*\\))*,\\s*(?:mode\\s*=\\s*)?['\"][wax]))",
      "action": "refuse",
      "agents": "sub",
      "reason": "an inline Python script that writes a file edits it without showing what changed: use the edit tool (read the lines first). For one rewrite across many files, save the script with the write tool and run it from a short command (`python3 /path/script.py`). If the text only mentions it (a commit message, a PR body), put it in a file with the write tool and pass the file"
    },
    { "pattern": "(^|[;&|(\\s])(npm|pnpm|yarn|bun)\\s+(run\\s+)?test\\b", "action": "queue", "queue": "test" },
    { "pattern": "(^|[;&|(\\s])(npm|pnpm|yarn|bun)\\s+run\\s+build\\b", "action": "queue", "queue": "build" },
    {
      "pattern": "(^|[;&|(\\s])pkill\\b",
      "action": "refuse",
      "reason": "pkill can stop other agents' processes; stop only the process you started, by its PID"
    },
    {
      "pattern": "(^|[;&|(\\s])git\\s+(-C\\s+\\S+\\s+)?stash\\b",
      "action": "refuse",
      "reason": "stashes are shared by all worktrees: commit to a throwaway branch instead"
    }
  ],
  "resources": {
    "ports": { "from": 20000, "to": 20999, "perSession": 200, "perAgent": 10 },
    "scratch": ".omp-coord-scratch"
  },
  "protect": { "roots": ["."], "allow": [], "agents": "sub" },
  "messages": { "perMinute": 10 },
  "history": { "retentionDays": 30, "maxEvents": 100000 }
}
