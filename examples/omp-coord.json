{
  "scope": "lightcraft",
  "agents": {
    "pools": {
      "work": { "cap": 8, "loadCaps": [{ "above": 150, "cap": 4 }] },
      "short": { "cap": 2, "agentTypes": ["scout"] }
    },
    "defaultPool": "work",
    "exempt": ["reviewer", "security-reviewer"],
    "nested": { "allow": ["reviewer", "security-reviewer"], "maxRunningPerParent": 1 },
    "holdMinutes": 5,
    "startTimeoutSeconds": 120
  },
  "queues": {
    "heavy": {
      "slots": 2,
      "order": "fair-share",
      "lanes": ["front", "normal"],
      "agingMinutes": 15,
      "timeoutMinutes": 120,
      "loadSlots": [{ "above": 150, "slots": 1 }]
    },
    "test": { "slots": 3, "order": "fair-share", "agingMinutes": 10, "timeoutMinutes": 60 }
  },
  "resources": {
    "ports": { "from": 18700, "to": 19999, "perSession": 200, "perAgent": 10 },
    "scratch": "/tmp/lightcraft-scratch"
  },
  "messages": { "perMinute": 10 },
  "history": { "retentionDays": 30, "maxEvents": 100000 },
  "commands": [
    {
      "pattern": "(^|[;&|(\\s])cargo\\s+(test|check|clippy)\\b",
      "action": "refuse",
      "reason": "use the recipes (just test, just test-ui, just check, just lint): they queue for a test slot and set the test config folder"
    },
    {
      "pattern": "(^|[;&|(\\s])cargo\\s+xtask\\s+ci\\b",
      "action": "refuse",
      "reason": "use just ci: it queues for a heavy slot and writes the log"
    },
    {
      "pattern": "(^|[;&|(\\s])cargo\\s+build\\b[^;&|]*--release",
      "action": "refuse",
      "reason": "use just build: it queues for a heavy slot"
    },
    {
      "pattern": "(^|[;&|(\\s])pkill\\b",
      "action": "refuse",
      "reason": "pkill can stop other agents' builds and shells; stop only the process you started, by its PID"
    },
    {
      "pattern": "(^|[;&|(\\s])git\\s+(-C\\s+\\S+\\s+)?stash\\b",
      "action": "refuse",
      "reason": "stashes are shared by all worktrees: commit to a throwaway branch instead"
    }
  ]
}
